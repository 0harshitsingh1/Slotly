// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

/// Represents the platform user roles: OWNER (manages business/services) and CUSTOMER (books services).
enum Role {
  OWNER
  CUSTOMER
}

/// Lifecycle status for bookings.
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ------------------------------------------------------
// Models
// ------------------------------------------------------

/// User model representing registered system accounts (both owners and customers).
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  role          Role     @default(CUSTOMER)
  name          String?
  created_at    DateTime @default(now())

  // Relations:
  // - A user with role OWNER can own multiple businesses.
  businesses          Business[]           @relation("BusinessOwner")
  // - A user with role CUSTOMER can create multiple bookings.
  bookings            Booking[]            @relation("CustomerBookings")
  // - One-to-many relationship with password reset tokens.
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// PasswordResetToken model storing secure tokens for password resets.
model PasswordResetToken {
  id         String   @id @default(cuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  // Relations:
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
  @@map("password_reset_tokens")
}

/// Business model representing service provider entities.
model Business {
  id          String   @id @default(cuid())
  owner_id    String
  name        String
  description String?
  address     String?
  timezone    String   @default("UTC")
  slug        String   @unique
  latitude    Float?
  longitude   Float?

  // Relations:
  // - FK to User model (the business owner).
  owner                  User                    @relation("BusinessOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  // - One-to-many relationship with offered services.
  services               Service[]
  // - One-to-many relationship with recurring weekly availability rules.
  availabilities         Availability[]
  // - One-to-many relationship with holiday/exception dates.
  availabilityExceptions AvailabilityException[]
  // - One-to-many relationship with customer bookings.
  bookings               Booking[]
  // - One-to-many relationship with uploaded business photos.
  images                 BusinessImage[]

  @@index([owner_id])
  @@map("businesses")
}

/// BusinessImage model storing uploaded photo URLs for a business.
model BusinessImage {
  id          String   @id @default(cuid())
  business_id String
  url         String
  created_at  DateTime @default(now())

  // Relations:
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id])
  @@map("business_images")
}

/// Service model defining appointment offerings by a business.
model Service {
  id               String  @id @default(cuid())
  business_id      String
  name             String
  duration_minutes Int
  price            Float
  buffer_minutes   Int     @default(0)

  // Relations:
  // - FK to Business model.
  business Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  // - One-to-many relationship with bookings made for this service.
  bookings Booking[]

  @@index([business_id])
  @@map("services")
}

/// Availability model defining recurring weekly operating hours (day 0=Sunday to 6=Saturday).
model Availability {
  id          String @id @default(cuid())
  business_id String
  day_of_week Int    // 0 (Sun) to 6 (Sat)
  start_time  String // e.g. "09:00" in business local timezone
  end_time    String // e.g. "17:00" in business local timezone

  // Relations:
  // - FK to Business model.
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  // Indexes:
  // - Composite index on business_id + day_of_week to quickly fetch operating hours when generating available booking slots for a specific day.
  @@index([business_id, day_of_week])
  @@map("availabilities")
}

/// AvailabilityException model for specific date overrides (holidays, special closures, custom hours).
model AvailabilityException {
  id          String   @id @default(cuid())
  business_id String
  date        DateTime // Date of exception (stored in UTC)
  is_closed   Boolean  @default(true)
  start_time  String?  // Optional custom start time if not fully closed
  end_time    String?  // Optional custom end time if not fully closed

  // Relations:
  // - FK to Business model.
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, date])
  @@map("availability_exceptions")
}

/// Booking model storing reservations made by customers.
model Booking {
  id          String        @id @default(cuid())
  business_id String
  service_id  String
  customer_id String
  start_at    DateTime      // Stored as UTC timestamp
  end_at      DateTime      // Stored as UTC timestamp
  status      BookingStatus @default(PENDING)
  created_at  DateTime      @default(now())

  // Relations:
  // - FK to Business model.
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  // - FK to Service model.
  service  Service  @relation(fields: [service_id], references: [id], onDelete: Cascade)
  // - FK to User model (the customer placing the booking).
  customer User     @relation("CustomerBookings", fields: [customer_id], references: [id], onDelete: Cascade)

  // Constraints & Indexes:
  // 1. Composite Unique Constraint on (business_id, start_at) to guarantee at the database level
  //    that two confirmed bookings cannot share the exact same start timestamp for the same business.
  //    (Note: For interval overlap enforcement [start_at, end_at), PostgreSQL GIST Exclusion constraints
  //     can be applied via custom SQL migrations:
  //     CREATE EXTENSION IF NOT EXISTS btree_gist;
  //     ALTER TABLE bookings ADD CONSTRAINT no_overlapping_confirmed_bookings
  //     EXCLUDE USING gist (business_id WITH =, tstzrange(start_at, end_at) WITH &&) WHERE (status = 'CONFIRMED');)
  @@unique([business_id, start_at])

  // 2. Composite Index on business_id + start_at to enable high-performance range queries
  //    when checking existing bookings for slot availability during search and checkout.
  @@index([business_id, start_at])
  // 3. Additional index for fast customer dashboard lookup.
  @@index([customer_id])
  @@map("bookings")
}
